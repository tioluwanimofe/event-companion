# Copy this file to .env (same folder) and put your real password in .env.
# .env is ignored by Git; this example file is safe to commit.
DATABASE_URL=postgresql+psycopg://event_app:YOUR_PASSWORD@localhost:5432/event_companion

# Optional: a SEPARATE database used only by the automated tests.
# Tests wipe its tables, so its name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://event_app:YOUR_PASSWORD@localhost:5432/event_companion_test

# Optional: where the attendee app lives (booth QR codes link here).
# APP_BASE_URL=https://app.cyberdatacon.com

# --- Google sign-in (ADR 0004). See docs/google-sign-in-setup.md ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Make one by running task "5. Make a secret key".
SESSION_SECRET_KEY=
# People who can manage every event (comma-separated)
ADMIN_EMAILS=you@gmail.com
# Set to true once the API is served over https
# SESSION_COOKIE_SECURE=true
