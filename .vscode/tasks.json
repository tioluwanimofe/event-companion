{
  // One-click buttons for the backend (1-5) and the React app (6-8).
  // In VS Code: Terminal menu -> Run Task... -> pick one.
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}/backend" },
  "tasks": [
    {
      "label": "1. Install / update Python packages",
      "detail": "Installs everything listed in backend/requirements.txt into the .venv",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "problemMatcher": []
    },
    {
      "label": "2. Build / update database tables",
      "detail": "Alembic applies any new migrations to your local Postgres",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "alembic", "upgrade", "head"],
      "problemMatcher": []
    },
    {
      "label": "3. Start the API",
      "detail": "Runs FastAPI; open http://127.0.0.1:8000/api/docs in your browser. Stop with the trash-can icon.",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "fastapi", "dev", "app/main.py"],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "4. Run tests",
      "detail": "Runs every automated test against your _test database (needs TEST_DATABASE_URL in backend/.env)",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "pytest"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "5. Make a secret key",
      "detail": "Prints a long random string. Paste it into backend/.env as SESSION_SECRET_KEY=",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-c", "import secrets; print(secrets.token_urlsafe(48))"],
      "problemMatcher": []
    },
    {
      "label": "6. Install app packages",
      "detail": "npm install in frontend/ (once, and whenever package.json changes)",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "7. Start the app",
      "detail": "Runs React on http://localhost:5173 (start task 3, the API, too). Stop with the trash-can icon.",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "8. Run app tests",
      "detail": "Runs the React tests once (Vitest)",
      "type": "shell",
      "command": "npx vitest run",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "1b. Install test tools",
      "detail": "Installs pytest (only needed once, for task 4)",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements-dev.txt"],
      "problemMatcher": []
    },
    {
      "label": "Undo the last database migration",
      "detail": "Careful: removes the tables/columns the last migration added",
      "type": "process",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "args": ["-m", "alembic", "downgrade", "-1"],
      "problemMatcher": []
    }
  ]
}
